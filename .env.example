# ---------------------------------------------------------------------------
# whatsapp_backup - plantilla de configuracion
#
# Copiar a .env y completar. NUNCA versionar el .env real.
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (POSIX)
# ---------------------------------------------------------------------------

# --- Aplicacion ---
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------
# DATABASE_URL tiene prioridad. Si se deja vacia, se construye a partir de
# las variables POSTGRES_* de abajo.
# Formato: postgresql+psycopg://usuario:password@host:puerto/base
DATABASE_URL=postgresql+psycopg://postgres:112004@localhost:5432/whatsapp_backup

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=whatsapp_backup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=112004

# --- Rutas (relativas a la raiz del proyecto) -------------------------------
# session/ contiene el ESTADO DEL COMPANION (device.json + Signal store SQLite).
# Eso NO es la base de datos del backup: la del backup es PostgreSQL.
SESSION_DIR=./session
DATA_DIR=./data
MEDIA_DIR=./data/media
DIAGNOSTICS_DIR=./diagnostics
WA_VERSION_CACHE=./data/cache/wa_web_version.json

# --- Nombre mostrado en "Dispositivos vinculados" del telefono --------------
PAIRING_NAME=WhatsApp Backup

# Intentos de pairing. Cada intento muestra un QR valido durante ~120 s
# (plazo fijo de pywhats). Si caduca sin escanearse se piden refs nuevos.
# Solo reacciona al timeout: un 405 u otro fallo aborta al primer intento.
PAIRING_MAX_ATTEMPTS=3
# Ventana de validez que la API le promete al frontend para un QR, en
# segundos. NO es la vida del ref: pywhats lo rota antes (el primero a los
# 60 s, luego cada 20 s) y cada rotacion publica un QR nuevo. Este es el tope
# tras el cual, si no llego ninguno, se pide una vinculacion nueva.
PAIRING_QR_TTL=300

# --- Historial que se pide AL VINCULAR --------------------------------------
# pywhats 0.2.0 registra el companion con requires_full_sync=False y SIN
# history_sync_config, y por eso WhatsApp solo siembra un adelanto: de 40
# chats, 32 llegaron sin un solo mensaje (verificado comparando los blobs
# crudos contra lo persistido).
#
# Estos valores piden el historial completo. SOLO surten efecto en una
# vinculacion NUEVA: viajan en el DeviceProps del registro.
#
# Pedirlo no garantiza recibirlo: el servidor acota lo que envia y no puede
# entregar lo que el telefono ya no tiene. Un sync completo tarda mas y ocupa
# mas; poner PAIRING_FULL_SYNC=false vuelve al comportamiento anterior.
PAIRING_FULL_SYNC=true
PAIRING_FULL_SYNC_DAYS=3650
PAIRING_FULL_SYNC_SIZE_MB=102400
PAIRING_STORAGE_QUOTA_MB=102400

# --- Recuperacion historica (HISTORY_SYNC_ON_DEMAND) ------------------------
HISTORY_ON_DEMAND_COUNT=50
HISTORY_REQUEST_TIMEOUT=45

# Segundos sin recibir chunks de History Sync para dar por asentado
# el historial inicial. El backfill no arranca antes.
HISTORY_SETTLE_SECONDS=8
MAX_ON_DEMAND_CONCURRENCY=1

# Recorrer todos los chats solo DESPUES de que el canary recupere
# historial real. En false se queda en el canary, util para diagnosticar.
BACKFILL_ALL_AFTER_CANARY=true

# --- Multimedia -------------------------------------------------------------
MEDIA_DOWNLOAD_CONCURRENCY=2
# Cada cuantos segundos revisa el worker permanente si hay adjuntos nuevos.
# El pipeline es automatico: no hace falta reiniciar para que se descarguen.
MEDIA_WORKER_INTERVAL=20

# --- Mantenimiento automatico ------------------------------------------------
# Reconciliacion periodica en segundo plano: contadores, cursores, previas del
# sidebar, alias de identidad y estado de multimedia. SOLO recalcula; nunca
# borra nada. Las operaciones destructivas siguen en repair_db.py, que se
# ejecuta a mano. 0 desactiva la reconciliacion periodica (la del arranque
# sigue haciendose).
MAINTENANCE_INTERVAL_SECONDS=900

# --- API HTTP (service.py) ---------------------------------------------------
# service.py usa ESTE MISMO .env; no hay configuracion aparte para Flask.
# Escucha solo en localhost a proposito: la API expone el historial completo y
# no lleva autenticacion. Cambiar a 0.0.0.0 la abriria a toda la red.
API_HOST=127.0.0.1

# La API NO pide contrasena: sirve toda la copia de tus conversaciones y tu
# multimedia a quien llegue al puerto. Por eso escuchar en una direccion que
# no sea local exige activarlo aqui a proposito.
ALLOW_REMOTE_API=false
API_PORT=5000
# Origen del frontend, para CORS. El frontend vivira en otro repositorio.
FRONTEND_ORIGIN=http://localhost:4200

# --- Interfaz ---------------------------------------------------------------
GUI_ENABLED=true
TERMINAL_PROGRESS_ENABLED=true

# --- Compatibilidades con pywhats 0.2.0 -------------------------------------
# Cada flag corresponde a un bug REAL verificado en el paquete instalado.
# Ver README.md -> "Compatibilidades". Desactivar solo para diagnostico.

# Resolver la revision de WhatsApp Web en vivo desde web.whatsapp.com/sw.js.
# pywhats 0.2.0 lleva (2,3000,1035194821) fijo, que el servidor rechaza con 405.
COMPAT_WA_VERSION=true
WA_VERSION_FETCH_TIMEOUT=10

# save_device_store() usa os.fchmod(), inexistente en Windows.
COMPAT_WINDOWS_STORE=true

# Mantener vivo el socket tras pair-device-sign hasta recibir el restart 515.
COMPAT_PAIRING_515=true
PAIRING_515_TIMEOUT=20

# Reutilizar el ratchet cuando llega un PreKeySignalMessage repetido cuya OPK
# ya fue consumida legitimamente (semantica de libsignal).
COMPAT_PREKEY_REPLAY=true

# Exponer los WebMessageInfo individuales del blob de History Sync, que
# pywhats 0.2.0 descarga y descifra pero solo cuenta.
COMPAT_HISTORY_MESSAGES=true

# Registrar nuestro propio par PN<->LID en el mapa de Signal. Sin el, los
# mensajes que envias DESDE TU TELEFONO llegan al companion pero fallan con
# "no session for peer <tu propio LID>": la sesion existe, pero guardada bajo
# la direccion de telefono. pywhats ya sabe migrarla; solo le faltaba saber
# que esos dos identificadores son el mismo dispositivo.
COMPAT_OWN_LID_MAP=true

# Buscar anclas de historial en las mutaciones de app-state. Se midio contra
# la cuenta real: 61 mutaciones, CERO claves de mensaje. Queda como
# diagnostico, apagada, por si algun dia interesa repetir la medicion.
COMPAT_APPSTATE_SEEDS=false
