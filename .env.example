# ---------------------------------------------------------------------------
# whatsapp_backup - plantilla de configuracion
#
# Copiar a .env y completar. NUNCA versionar el .env real.
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (POSIX)
# ---------------------------------------------------------------------------

# --- Aplicacion ---
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------
# DATABASE_URL tiene prioridad. Si se deja vacia, se construye a partir de
# las variables POSTGRES_* de abajo.
# Formato: postgresql+psycopg://usuario:password@host:puerto/base
# Este archivo es una PLANTILLA y esta versionado: nunca pongas aqui una
# contrasena de verdad. Copialo a .env (ignorado por git) y rellenalo alli.
DATABASE_URL=postgresql+psycopg://postgres:TU_CONTRASENA@localhost:5432/whatsapp_backup

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=whatsapp_backup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TU_CONTRASENA

# --- Rutas (relativas a la raiz del proyecto) -------------------------------
# session/ contiene el ESTADO DEL COMPANION (device.json + Signal store SQLite).
# Eso NO es la base de datos del backup: la del backup es PostgreSQL.
SESSION_DIR=./session
DATA_DIR=./data
MEDIA_DIR=./data/media
DIAGNOSTICS_DIR=./diagnostics
WA_VERSION_CACHE=./data/cache/wa_web_version.json

# --- Nombre mostrado en "Dispositivos vinculados" del telefono --------------
PAIRING_NAME=WhatsApp Backup

# Intentos de pairing. Cada intento muestra un QR valido durante ~120 s
# (plazo fijo de pywhats). Si caduca sin escanearse se piden refs nuevos.
# Solo reacciona al timeout: un 405 u otro fallo aborta al primer intento.
PAIRING_MAX_ATTEMPTS=3
# Ventana de validez que la API le promete al frontend para un QR, en
# segundos. NO es la vida del ref: pywhats lo rota antes (el primero a los
# 60 s, luego cada 20 s) y cada rotacion publica un QR nuevo. Este es el tope
# tras el cual, si no llego ninguno, se pide una vinculacion nueva.
PAIRING_QR_TTL=300

# --- Historial que se pide AL VINCULAR --------------------------------------
# pywhats 0.2.0 registra el companion con requires_full_sync=False y SIN
# history_sync_config, y por eso WhatsApp solo siembra un adelanto: de 40
# chats, 32 llegaron sin un solo mensaje (verificado comparando los blobs
# crudos contra lo persistido).
#
# Estos valores piden el historial completo. SOLO surten efecto en una
# vinculacion NUEVA: viajan en el DeviceProps del registro.
#
# Pedirlo no garantiza recibirlo: el servidor acota lo que envia y no puede
# entregar lo que el telefono ya no tiene. Un sync completo tarda mas y ocupa
# mas; poner PAIRING_FULL_SYNC=false vuelve al comportamiento anterior.
PAIRING_FULL_SYNC=true
PAIRING_FULL_SYNC_DAYS=3650
PAIRING_FULL_SYNC_SIZE_MB=102400
PAIRING_STORAGE_QUOTA_MB=102400

# --- Recuperacion historica (HISTORY_SYNC_ON_DEMAND) ------------------------
HISTORY_ON_DEMAND_COUNT=50
HISTORY_REQUEST_TIMEOUT=45

# Segundos sin recibir chunks de History Sync para dar por asentado
# el historial inicial. El backfill no arranca antes.
HISTORY_SETTLE_SECONDS=8
MAX_ON_DEMAND_CONCURRENCY=1

# Recorrer todos los chats solo DESPUES de que el canary recupere
# historial real. En false se queda en el canary, util para diagnosticar.
BACKFILL_ALL_AFTER_CANARY=true

# --- Multimedia -------------------------------------------------------------
MEDIA_DOWNLOAD_CONCURRENCY=2
# Cada cuantos segundos revisa el worker permanente si hay adjuntos nuevos.
# El pipeline es automatico: no hace falta reiniciar para que se descarguen.
MEDIA_WORKER_INTERVAL=20

# --- Mantenimiento automatico ------------------------------------------------
# Reconciliacion periodica en segundo plano: contadores, cursores, previas del
# sidebar, alias de identidad y estado de multimedia. SOLO recalcula; nunca
# borra nada. Las operaciones destructivas siguen en repair_db.py, que se
# ejecuta a mano. 0 desactiva la reconciliacion periodica (la del arranque
# sigue haciendose).
MAINTENANCE_INTERVAL_SECONDS=900

# --- API HTTP (service.py) ---------------------------------------------------
# service.py usa ESTE MISMO .env; no hay configuracion aparte para Flask.
# Escucha solo en localhost a proposito: la API expone el historial completo y
# no lleva autenticacion. Cambiar a 0.0.0.0 la abriria a toda la red.
API_HOST=127.0.0.1

# La API NO pide contrasena: sirve toda la copia de tus conversaciones y tu
# multimedia a quien llegue al puerto. Por eso escuchar en una direccion que
# no sea local exige activarlo aqui a proposito.
ALLOW_REMOTE_API=false
API_PORT=5000
# Origen del frontend, para CORS. El frontend vivira en otro repositorio.
FRONTEND_ORIGIN=http://localhost:4200

# --- Interfaz ---------------------------------------------------------------

TERMINAL_PROGRESS_ENABLED=true

# --- Compatibilidades con pywhats 0.2.0 -------------------------------------
# Cada flag corresponde a un bug REAL verificado en el paquete instalado.
# Ver README.md -> "Compatibilidades". Desactivar solo para diagnostico.

# Resolver la revision de WhatsApp Web en vivo desde web.whatsapp.com/sw.js.
# pywhats 0.2.0 lleva (2,3000,1035194821) fijo, que el servidor rechaza con 405.
COMPAT_WA_VERSION=true
WA_VERSION_FETCH_TIMEOUT=10

# save_device_store() usa os.fchmod(), inexistente en Windows.
COMPAT_WINDOWS_STORE=true

# Mantener vivo el socket tras pair-device-sign hasta recibir el restart 515.
COMPAT_PAIRING_515=true
PAIRING_515_TIMEOUT=20

# Reutilizar el ratchet cuando llega un PreKeySignalMessage repetido cuya OPK
# ya fue consumida legitimamente (semantica de libsignal).
COMPAT_PREKEY_REPLAY=true

# Exponer los WebMessageInfo individuales del blob de History Sync, que
# pywhats 0.2.0 descarga y descifra pero solo cuenta.
COMPAT_HISTORY_MESSAGES=true

# Registrar nuestro propio par PN<->LID en el mapa de Signal. Sin el, los
# mensajes que envias DESDE TU TELEFONO llegan al companion pero fallan con
# "no session for peer <tu propio LID>": la sesion existe, pero guardada bajo
# la direccion de telefono. pywhats ya sabe migrarla; solo le faltaba saber
# que esos dos identificadores son el mismo dispositivo.
COMPAT_OWN_LID_MAP=true

# Buscar anclas de historial en las mutaciones de app-state. Se midio contra
# la cuenta real: 61 mutaciones, CERO claves de mensaje. Queda como
# diagnostico, apagada, por si algun dia interesa repetir la medicion.
COMPAT_APPSTATE_SEEDS=false

# --- Revision de historiales pendientes -------------------------------------
# Al abrir el panel se intenta una revision local (alias y blobs ya
# entregados). Reinterpretar los blobs de decenas de chats no es gratis, asi
# que la automatica respeta esta espera entre ejecuciones; el boton manual no
# la respeta nunca. 0 la desactiva.
AUTO_RECHECK_COOLDOWN_SECONDS=300

# --- Experimental (app/experimental) ----------------------------------------
# Vincula un SEGUNDO dispositivo a la cuenta, con su propio QR, para intentar
# conseguir un ancla en los chats que llegaron sin ninguna. El producto no lo
# necesita y funciona entero sin ello. Se midio contra la cuenta real:
# "no encontrado" fue el resultado habitual.
WEB_BOOTSTRAP_ENABLED=false

# ---------------------------------------------------------------------------
# CUENTAS Y AUTENTICACION
# ---------------------------------------------------------------------------

# Nombre de la cookie de sesion. Su contenido es un token opaco de 256 bits;
# en la base solo se guarda su SHA-256.
SESSION_COOKIE_NAME=whatsapp_backup_session
SESSION_LIFETIME_DAYS=30

# En localhost NO hay HTTPS: con Secure=true la cookie no llegaria nunca y el
# login "fallaria" sin ningun error visible. En produccion tiene que ser true.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Cifra los tokens de Google guardados en PostgreSQL, y de ella se deriva la
# clave que firma la cookie de estado del OAuth. Sin ella no se puede conectar
# Google. Generala con:
#     py -c "from app.auth.crypto import generar_clave; print(generar_clave())"
# NUNCA la pongas en git.
APP_ENCRYPTION_KEY=

# A donde vuelve el usuario despues del OAuth.
FRONTEND_URL=http://localhost:4200

# La URL por la que el NAVEGADOR llega a esta API. Distinta de API_HOST, que
# es donde escucha el proceso (127.0.0.1, sin exposicion remota).
#
# Tiene que ser "localhost", no "127.0.0.1": para el navegador son sitios
# DISTINTOS, y una cookie SameSite=Lax puesta en uno no viaja en las
# peticiones que hace el otro. Con el frontend en localhost:4200 y la API en
# 127.0.0.1:5000, la sesion se creaba bien y despues no se enviaba nunca.
API_PUBLIC_URL=http://localhost:5000

# --- Google OAuth (ver docs/GOOGLE_OAUTH_SETUP.md) --------------------------
# Este archivo esta VERSIONADO. El client_secret va solo en .env, que git
# ignora. Un secreto en un repositorio se rastrea en minutos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# ALMACENAMIENTO DEL CONTENIDO (GOOGLE DRIVE)
# ---------------------------------------------------------------------------
#
# PostgreSQL guarda el INDICE (quien, cuando, en que segmento). Drive guarda el
# CONTENIDO. Asi la base no crece hasta ser el problema.
DRIVE_STORAGE_ENABLED=true

# Los mensajes se agrupan en segmentos: uno por archivo daria millones de
# archivos en Drive. Un segmento se cierra al llegar a CUALQUIERA de los tres
# limites.
DRIVE_MESSAGE_SEGMENT_MAX_MESSAGES=1000
DRIVE_MESSAGE_SEGMENT_MAX_BYTES=5242880

# La edad importa tanto como el tamano: sin ella, un chat con poco trafico
# dejaria su segmento abierto y esos mensajes no llegarian nunca a Drive.
DRIVE_SEGMENT_MAX_AGE_SECONDS=60

# La copia local de multimedia es CACHE, no el original. Se desaloja por
# tamano y por edad, y SOLO lo que ya esta confirmado en Drive.
LOCAL_MEDIA_CACHE_MAX_GB=5
LOCAL_MEDIA_CACHE_TTL_HOURS=24

# Si Drive lleva dias caido, lo pendiente no puede crecer sin limite. Al
# llegar aqui se avisa (STORAGE_BLOCKED). NO se borra ningun mensaje.
MAX_PENDING_STORAGE_BYTES=10737418240

# Google cifra su disco, pero tiene la llave. Cifrando aqui, lo que sube es
# opaco tambien para Google.
STORAGE_ENCRYPTION_ENABLED=true

# Clave que envuelve las claves de contenido de cada usuario. Si se deja
# vacia se DERIVA de APP_ENCRYPTION_KEY con HKDF y una etiqueta distinta, que
# ya separa los dominios; ponerla aparte los separa del todo.
#     py -c "from app.storage.encryption import Fernet" # (ver docs)
# OJO: cambiarla deja ilegible todo lo ya subido.
STORAGE_KEK=

# ---------------------------------------------------------------------------
# DETALLE DE LOS REGISTROS
# ---------------------------------------------------------------------------
#
# Las peticiones HTTP correctas (200/204/206/304) no se registran: con el
# panel abierto son decenas por minuto y entierran lo unico que hay que ver.
# Los 4xx y 5xx SIEMPRE se ven. Ponlo en true para diagnosticar el frontend.
HTTP_ACCESS_LOG=false

# Detalle de protocolo: cursores, ACKs, forma de las peticiones, reutilizacion
# de ratchet, tipos de History Sync. NO se ha borrado nada; con esto en true
# vuelve a verse todo.
PROTOCOL_DEBUG=false

# Ventana tras conectar en la que se da prioridad a buscar anclas de historial
# (mensajes pendientes, reenvios). Pasada la ventana el buscador sigue activo:
# esto solo sirve para medir.
RECENT_SEED_OBSERVATION_SECONDS=120

# ---------------------------------------------------------------------------
# WEB COMPANION (experimental)
# ---------------------------------------------------------------------------
#
# Vincula OTRO dispositivo a la cuenta, con su propio QR y su propia sesion,
# usando whatsapp-web.js y un Chromium. Sirve para MEDIR una sola cosa: de las
# conversaciones que esperan una referencia, cuantas ve WhatsApp Web y de
# cuantas puede dar un mensaje real.
#
# En esta fase SOLO mide. No anota anclas, no cambia estados y no pide
# historial. Requiere instalar dependencias a mano:
#     py tools/setup_web_companion.py
WEB_COMPANION_ENABLED=false

# Ruta a Chrome/Chromium. Vacio deja que puppeteer use el suyo.
WEB_COMPANION_CHROME=

# Nivel 2. Pedirle al Store que cargue mensajes anteriores cuando lo que ya
# esta cargado no basta. Se mide el Nivel 1 primero.
WEB_STORE_LOAD_EARLIER=false

# Forzar la carga diferida del panel lateral desplazandolo. El proyecto
# anterior hacia 80 desplazamientos por defecto; aqui esta apagado hasta
# comprobar si getChats() y Store.Chat ya bastan.
WEB_STORE_DISCOVERY_SCROLL=false

# --- Plan J3.1: la prueba simetrica --------------------------------------
#
# Instrumentacion de UN experimento con fecha, no funciones del producto. Las
# tres vienen apagadas y solo se encienden mientras dura la medicion.
#
# EL PROBLEMA QUE RESUELVEN
# Las fases anteriores compararon ocho conversaciones con ancla de la sesion
# principal contra treinta y siete del navegador. Las ocho eran de un instante
# --el arranque-- y las treinta y siete de varios dias acumulados. Eso no dice
# que el navegador reciba un arranque mejor: puede decir solo que su sesion era
# mas vieja. Estas banderas permiten medir los dos lados a la MISMA edad.

# Cronometra los dos lados desde el T0 de cada uno y guarda las fotos de los
# 0, 30, 60 y 120 segundos en debug/plan_j31/. Se alarga a 300 solo si a los
# 120 la cosa seguia moviendose.
PLAN_J31_ENABLED=1

# FASE A: la sesion principal, SOLA. El segundo dispositivo no arranca por
# ninguna puerta --ni la API, ni el reintento automatico, ni las herramientas--
# aunque la principal este perfectamente lista. Lo que se mide ahi es lo que
# recibe una principal sin companion; con uno vinculado a media medicion, la
# cifra ya no responde a esa pregunta.
PLAN_J31_PRIMARY_ONLY=1

# Corta ON_DEMAND mientras dura la ventana. Excavar mientras se mide que trae
# el ARRANQUE mezclaria anclas de dos fuentes, y la cifra dejaria de significar
# lo que dice medir. No es un limite del servidor ni un fallo: es una pausa
# deliberada, y se anota como tal en el registro.
PLAN_J31_FREEZE_HISTORY=1
